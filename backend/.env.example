# Copy to .env for local use. On Render, add these under Environment.
# Never commit the real .env.

# Supabase (Project Settings → API). The service key has FULL database access.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Long random string used to sign logins. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# Port (Render sets this itself).
PORT=5000

# --- Production only ---
# NODE_ENV=production                         # also switches the developer console off
# DEVELOPER_PORTAL_ENABLED=false              # developer console off (keep off on any public server)
# ALLOWED_ORIGINS=https://your-site.vercel.app # the website(s) allowed to call this API, comma-separated
# TRUST_PROXY=1                                # behind Render/Nginx: real visitor IPs for the login limiter

# --- Optional ---
# OUTPASS_GRACE_MINUTES=30
# OUTPASS_EARLY_EXIT_MINUTES=60
# COMPLAINT_ESCALATION_HOURS=24
# UPLOAD_BUCKET=uploads                        # Supabase Storage bucket for photos

# --- Hostel Assistant chatbot (optional) ---
# Without a key the assistant still works, answering from its built-in FAQ and the student's records.
# ANTHROPIC_API_KEY=your-claude-api-key        # from https://platform.claude.com — keep it here, never in the frontend
# CHATBOT_MODEL=claude-opus-5-5                # which Claude model answers
